# =============================================================================
#  roboomp environment
# =============================================================================
#
# This file is read in two distinct ways and you MUST keep that in mind when
# filling it in:
#
#   1. `docker compose` interpolates `${VAR}` references in docker-compose.yml.
#      The compose file uses per-service explicit `environment:` allowlists
#      (NO `env_file:`), so only the keys listed in each service's block flow
#      into the corresponding container — never the whole .env.
#
#   2. The Python `Settings` loader (`src/config.py`) also reads `.env`
#      for any local CLI invocation (e.g. `python -m carter_omp.cli triage …`
#      running on the host outside docker). `_validate_proxy_or_pat` fails
#      fast if BOTH a PAT and `CARTER_OMP_GH_PROXY_URL` are configured, so the
#      two modes below are mutually exclusive.
#
# Pick ONE of the two mode blocks below; leave the other fully commented out.
# Variables under "### shared ###" apply in either mode.


# =============================================================================
#  ### shared ### — required regardless of mode
# =============================================================================

# Shared HMAC secret used to verify webhook signatures. Must match the secret
# configured in the GitHub webhook UI / settings.
GITHUB_WEBHOOK_SECRET=

# GitHub login handle for the bot account whose PAT is in GITHUB_TOKEN (or
# whichever account the github-proxy authenticates as). Prefer the lowercase bare
# mention handle (`roboomp`, not `@roboomp` or `roboomp[bot]`); startup
# normalizes common forms, including uppercase and surrounding whitespace.
CARTER_OMP_BOT_LOGIN=

# Commit identity for branches the bot pushes. The email is what reviewers and
# GitHub will display next to the commit; pick one that matches how you want
# bot-authored commits to appear (a no-reply alias, a real address, etc.).
# `gh_push_branch` refuses to push unless every commit on the workspace branch
# carries this exact name + email.
CARTER_OMP_GIT_AUTHOR_NAME=
CARTER_OMP_GIT_AUTHOR_EMAIL=

# Comma-separated owner/repo entries the bot is allowed to act on.
CARTER_OMP_REPO_ALLOWLIST=

# Immutable authorization identity (the root of trust; logins/names are
# readability + startup validation only, never the authority check).
CARTER_OMP_AUTHORIZED_USER_IDS=
CARTER_OMP_AUTHORIZED_LOGINS=
CARTER_OMP_REPO_IDS=
CARTER_OMP_REPOS=
# Owner scope: any repo owned by these logins is authorized (past, present,
# future) without listing IDs. Example: `carterlasalle`. Empty = ID-list only.
CARTER_OMP_REPO_OWNERS=
CARTER_OMP_GITHUB_APP_ID=
CARTER_OMP_GITHUB_INSTALLATION_ID=
CARTER_OMP_GITHUB_PRIVATE_KEY_FILE=/run/secrets/github-app.pem

# Trigger behavior: strict = explicit label/mention only (production default).
CARTER_OMP_TRIGGER_MODE=strict
CARTER_OMP_TRIGGER_LABEL=carter-omp
CARTER_OMP_LABEL_TRIGGERS=true
CARTER_OMP_MENTION_TRIGGERS=true
CARTER_OMP_AUTO_ISSUE_TRIAGE=false
CARTER_OMP_AUTO_PR_REVIEW=false
CARTER_OMP_AUTO_COMMENT_FOLLOWUPS=false
CARTER_OMP_REVIEWER_BOTS=

# Optional comma-separated GitHub logins whose @CARTER_OMP_BOT_LOGIN comments may
# authorize implementation work in addition to repo OWNER. Prefer lowercase
# bare logins; startup ignores leading `@`, case, whitespace, and `[bot]`.
CARTER_OMP_MAINTAINER_LOGINS=


# =============================================================================
#  ### github-proxy mode (RECOMMENDED, default in docker compose) ###
#
#  The orchestrator NEVER holds the PAT; it talks to the sibling github-proxy
#  container over an internal-only docker network, authenticated with a
#  shared HMAC key. Fill in BOTH variables below and leave the PAT mode
#  block fully commented out.
# =============================================================================

# Shared HMAC secret the orchestrator uses to authenticate every request to
# github-proxy. The two containers MUST agree on this value. The proxy refuses
# any unsigned request; the orchestrator refuses to start without it.
# Generate with: openssl rand -hex 32
CARTER_OMP_GH_PROXY_HMAC_KEY=

# URL the orchestrator uses to reach github-proxy. The default below matches the
# service name + port in docker-compose.yml; override only for local
# development outside compose (e.g. `http://127.0.0.1:8081`).
CARTER_OMP_GH_PROXY_URL=http://github-proxy:8081

# PAT with `repo` (push, comment, PR) scope. A fine-grained token scoped to
# the allowlisted repos is recommended; a classic PAT also works.
#
# In github-proxy mode this value lives ONLY in the github-proxy container's
# environment (compose interpolates it into github-proxy's allowlist only).
# Settings refuses to construct an orchestrator config that sees both
# GITHUB_TOKEN and CARTER_OMP_GH_PROXY_URL, so when running orchestrator code
# directly on the host (CLI, tests) you MUST keep GITHUB_TOKEN unset.
GITHUB_TOKEN=


# =============================================================================
#  ### PAT mode (single-process, no sidecar) ###
#
#  Drop the github-proxy entirely and let the orchestrator hold the PAT directly.
#  To use this mode: uncomment GITHUB_TOKEN below, leave CARTER_OMP_GH_PROXY_URL
#  and CARTER_OMP_GH_PROXY_HMAC_KEY UNSET (above), and run the orchestrator
#  outside of the bundled docker-compose (which is wired for proxy mode).
# =============================================================================

# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# =============================================================================
#  --- Model selection ---
# =============================================================================
# Either a single model id or a comma-separated pool — roboomp picks one
# uniformly at random per task. Use the `<provider>/<model>` form that matches
# your ~/.omp/agent/models.container.yml (which is mounted into the container as models.yml).
CARTER_OMP_MODEL=anthropic/claude-sonnet-4-6
# off|low|medium|high
CARTER_OMP_THINKING=high
# Optional provider override (passed to `omp --provider`).
# CARTER_OMP_PROVIDER=


# =============================================================================
#  --- Runtime ---
# =============================================================================
CARTER_OMP_MAX_CONCURRENCY=8
CARTER_OMP_TASK_TIMEOUT_SECONDS=2400
CARTER_OMP_TASK_TIMEOUT_HARD_GRACE_SECONDS=60
CARTER_OMP_REQUEST_TIMEOUT_SECONDS=120
# Strip node_modules + the per-workspace bun cache after every task run (and
# once at boot). Deps are reinstalled at each run start, so this only costs a
# re-download per run — leaving it on keeps disk usage bounded by concurrency
# instead of by the number of open issues.
CARTER_OMP_RECLAIM_WORKSPACE_CACHES=true



# =============================================================================
#  --- Release sentinel ---
# =============================================================================
# Default-off because release retries push directly to main and move the
# release tag. Before enabling, subscribe the repository webhook to
# "Workflow runs" and grant the bot PAT "Actions: Read".
CARTER_OMP_RELEASE_SENTINEL_ENABLED=false
CARTER_OMP_RELEASE_COMMIT_PREFIX="chore: bump version to "
CARTER_OMP_RELEASE_MAX_ROUNDS=5
CARTER_OMP_RELEASE_TASK_TIMEOUT_SECONDS=3600
# Optional single model or comma-separated pool. Falls back to CARTER_OMP_MODEL.
# CARTER_OMP_RELEASE_MODEL=

# =============================================================================
#  --- PR review ---
# =============================================================================
# Set CARTER_OMP_PR_REVIEW_ENABLED=false to disable carter-omp PR review entirely.
CARTER_OMP_PR_REVIEW_ENABLED=true


# =============================================================================
#  --- Per-submitter rate limiting ---
# =============================================================================
# Rolling window plus per-tier caps on queue-worthy submissions per
# GitHub login. Accounts whose webhook payload reports author_association
# OWNER/MEMBER/COLLABORATOR bypass the limiter automatically. Use the
# unlimited list (comma-separated logins, `@` optional) to whitelist
# additional users — e.g. yourself when developing outside the repo.
CARTER_OMP_RATE_LIMIT_WINDOW_SECONDS=3600
CARTER_OMP_RATE_LIMIT_DEFAULT=3
CARTER_OMP_RATE_LIMIT_CONTRIBUTOR=10
CARTER_OMP_RATE_LIMIT_UNLIMITED=


# =============================================================================
#  --- Question auto-close ---
# =============================================================================
# When the bot answers an issue classified as `question` it appends a
# 👎-to-keep-open prompt and schedules the issue to close as
# `state_reason=completed` after `HOURS`. Set `ENABLED=false` (or `HOURS=0`)
# to disable. Cancellation is automatic on a follow-up comment, an external
# close, or the issue author downvoting the bot's comment.
CARTER_OMP_QUESTION_AUTOCLOSE_ENABLED=false
CARTER_OMP_QUESTION_AUTOCLOSE_HOURS=4
# How often the scheduler scans for due rows. 60s is plenty given the
# multi-hour close window.
CARTER_OMP_QUESTION_AUTOCLOSE_SCAN_SECONDS=60

# =============================================================================
#  --- Local issue search index ---
# =============================================================================
# `gh_search_issues` answers from a local SQLite FTS mirror of every issue/PR
# in the allowlisted repos. Webhooks keep it fresh in real time; this interval
# controls the periodic GitHub reconcile (first pass backfills each repo).
# Set <= 0 to disable the reconciler — the tool then uses the GitHub search
# API until a repo has been backfilled.
CARTER_OMP_ISSUE_INDEX_SYNC_SECONDS=900

# Path or command name for the omp binary inside the container. The shipped
# image installs a pinned prebuilt OMP release (see Dockerfile); no monorepo
# checkout is mounted or required.
CARTER_OMP_OMP_COMMAND=omp


# =============================================================================
#  --- Paths (inside the container) ---
# =============================================================================
CARTER_OMP_WORKSPACE_ROOT=/data/workspaces
CARTER_OMP_SQLITE_PATH=/data/carter-omp.sqlite
CARTER_OMP_LOG_DIR=/data/logs


# =============================================================================
#  --- Dev only ---
# =============================================================================
# Bind address for the webhook receiver.
CARTER_OMP_BIND_HOST=0.0.0.0
CARTER_OMP_BIND_PORT=8080

# Optional token enabling the POST /replay endpoint; leave blank to disable.
# CARTER_OMP_REPLAY_TOKEN=

# =============================================================================
#  --- OMP runtime ---
# =============================================================================
# OMP is an external runtime pinned in the Docker image (exact release +
# checksum). No oh-my-pi checkout is mounted or required. carter-omp's own
# Python env is managed with uv; the dashboard uses Yarn.
